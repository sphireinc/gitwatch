{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sphireinc/git-watch/main/docs/configuration.schema.json",
  "title": "gitwatch configuration v3",
  "type": "object",
  "properties": {
    "version": { "const": 3 },
    "theme": { "enum": ["auto", "dark", "light", "high-contrast"] },
    "motion": { "enum": ["full", "reduced", "off"] },
    "watch": { "enum": ["auto", "fs", "poll"] },
    "interval": { "type": "integer", "minimum": 1 },
    "reconciliation": { "type": "integer", "minimum": 0 },
    "show_untracked": { "type": "boolean" },
    "show_ignored": { "type": "boolean" },
    "mouse": { "type": "boolean" },
    "show_commit_tree": { "type": "boolean" },
    "debounce": { "type": "integer", "minimum": 0 },
    "repositories": {
      "type": "object",
      "properties": {
        "roots": { "type": "array", "items": { "type": "string" } },
        "groups": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
        "group_refresh": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "group_auto_fetch": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "ignore_dirs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "max_depth": { "type": "integer", "minimum": 0 },
        "max_repositories": { "type": "integer", "minimum": 0 }
      }
    },
    "remote": {
      "type": "object",
      "properties": {
        "pull_strategy": { "enum": ["merge", "rebase", "ff-only"] },
        "stale_after": { "type": "integer", "minimum": 0 },
        "workers": { "type": "integer", "minimum": 0 },
        "auto_fetch": { "type": "boolean" },
        "auto_fetch_interval": { "type": "integer", "minimum": 0 },
        "auto_fetch_jitter": { "type": "integer", "minimum": 0 },
        "auto_fetch_backoff": { "type": "integer", "minimum": 0 },
        "auto_fetch_backoff_max": { "type": "integer", "minimum": 0 },
        "auto_fetch_profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": { "type": "boolean" },
              "interval": { "type": "integer", "minimum": 0 },
              "jitter": { "type": "integer", "minimum": 0 },
              "backoff": { "type": "integer", "minimum": 0 },
              "backoff_max": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "github": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "token_env": { "type": "string" },
        "cache_ttl": { "type": "integer", "minimum": 0 }
      }
    },
    "plugins": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "directories": { "type": "array", "items": { "type": "string" } },
        "max_output": { "type": "integer", "minimum": 0 }
      }
    },
    "notifications": { "type": "object", "properties": { "quiet": { "type": "boolean" } } },
    "layout": {
      "type": "object",
      "properties": {
        "files_percent": { "type": "integer", "minimum": 1, "maximum": 99 },
        "details_percent": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "diff": {
      "type": "object",
      "properties": {
        "max_bytes": { "type": "integer", "minimum": 1 },
        "max_lines": { "type": "integer", "minimum": 1 }
      }
    },
    "tools": {
      "type": "object",
      "properties": {
        "editor": { "$ref": "#/$defs/tool" },
        "opener": { "$ref": "#/$defs/tool" },
        "difftool": { "$ref": "#/$defs/tool" }
      }
    },
    "custom_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "executable"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "contexts": { "type": "array", "items": { "type": "string" } },
          "binding": { "type": "string" },
          "label": { "type": "string" },
          "executable": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "directory": { "type": "string" },
          "timeout": { "type": "integer", "minimum": 0 },
          "confirm": { "type": "boolean" },
          "mutates_repository": { "type": "boolean" },
          "refresh": { "type": "boolean" },
          "prompts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "kind"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "label": { "type": "string", "minLength": 1 },
                "kind": { "enum": ["text", "secret", "confirm", "select", "multi-select"] },
                "required": { "type": "boolean" },
                "pattern": { "type": "string" },
                "options": { "type": "array", "items": { "type": "string" } },
                "options_source": { "enum": ["branches", "remotes", "tags", "commits", "paths"] },
                "default": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "gitignore_max_bytes": { "type": "integer", "minimum": 1 },
    "commit_tree": {
      "type": "object",
      "properties": { "max_commits": { "type": "integer", "minimum": 1, "maximum": 1000 } }
    },
    "workspace": {
      "type": "object",
      "properties": {
        "palette_max_results": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "status_overscan": { "type": "integer", "minimum": 0, "maximum": 32 }
      }
    },
    "visuals": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "activity_buckets": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "profile": { "type": "string" },
    "keymap": { "type": "object", "additionalProperties": { "type": "string" } },
    "keymap_profiles": {
      "type": "object",
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "string" } }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
